# ====================
# Model Source & Cache
# ====================
# 模型来源（ModelScope / HuggingFace）
MINERU_MODEL_SOURCE=modelscope
# ModelScope 离线模式（1=启用）
MODELSCOPE_OFFLINE=1
# ModelScope 模型缓存路径
MODELSCOPE_CACHE=D:/ai_models/modelscope_cache
# Hugging Face 缓存路径
HF_HOME=D:/ai_models/huggingface_cache
# 临时文件根目录
MD_ROOT_DIR=./temp-files/

# ====================
# OpenAI / LLM API (DashScope compatible)
# ====================
# API 密钥（兼容 OpenAI 格式）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# API 基础地址
OPENAI_API_BASE=https://api.deepseek.com
# 默认 LLM 模型
LLM_DEFAULT_MODEL=deepseek-v4-flash
# 默认温度参数（0-1，越低越稳定）
LLM_DEFAULT_TEMPERATURE=0.1
# 视觉语言模型
VL_MODEL=deepseek-v4-flash-vision-exp
# 商品名识别模型
ITEM_MODEL=deepseek-v4-flash

# ====================
# BGE Embedding Models
# ====================
# BGE-M3 模型本地路径
BGE_M3_PATH=D:\ai_models\modelscope_cache\models\BAAI\bge-m3
# BGE-M3 模型名称
BGE_M3=BAAI/bge-m3
# 嵌入模型运行设备
BGE_DEVICE=cuda:0
# 是否使用半精度（True/False）
BGE_FP16=True
# BGE 重排序模型路径s
BGE_RERANKER_LARGE=D:\ai_models\modelscope_cache\models\BAAI\bge-reranker-large
# 重排序模型设备
BGE_RERANKER_DEVICE=cuda:0
# 重排序模型半精度
BGE_RERANKER_FP16=1

# ====================
# Embedding General
# ====================
# 嵌入向量维度（OpenAI text-embedding-v4）
EMBEDDING_DIM=1536
# 嵌入模型名称
EMBEDDING_MODEL=text-embedding-v4

# ====================
# Vector Database (Milvus)
# ====================
# Milvus 连接地址
MILVUS_URL=http://localhost:19530
# 知识库切片集合名
CHUNKS_COLLECTION=kb_chunks
# 商品名称集合名
ITEM_NAME_COLLECTION=kb_item_names
# 相似度度量方式
MILVUS_METRIC_TYPE=COSINE
# 最小余弦相似度阈值
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# 意图识别（三层漏斗）
# ====================
# 总开关：false 时意图节点直通默认策略，行为等同改造前（出问题第一回退手段）
# 各意图的检索策略（融合权重 / HNSW ef / HyDE 与联网开关 / 截断条数）在 config/intent_config.py
INTENT_ENABLED=true

# ====================
# 索引选型与蓝绿重建
# ====================
# 稠密索引 HNSW 建图参数（只对新建/重建的集合生效，改完要跑 rebuild 才吃到）
HNSW_M=32
HNSW_EF_CONSTRUCTION=256
# 重建期间新导入数据是否同时写新旧两个集合
INDEX_DOUBLE_WRITE_ENABLED=true
# 回填时每批搬运/重算的切片数
INDEX_BACKFILL_BATCH=200
# 默认重建方式：move_vectors=搬旧向量（快，embedding 模型没变时用）/ re_embed=重算向量
INDEX_REBUILD_MODE=move_vectors
# 旧索引切换后保留天数（回滚窗口），到期由 rebuild --cleanup 清理
INDEX_RETIRE_AFTER_DAYS=7
# 一致性校验：抽样条数 / 命中率最大差 / top10 Jaccard 下限 / move 模式 Jaccard 下限
INDEX_VALIDATE_SAMPLES=50
INDEX_VALIDATE_HIT_DIFF=0.01
INDEX_VALIDATE_JACCARD=0.85
INDEX_VALIDATE_JACCARD_MOVE=0.95
# 索引质量告警：sealed segment 上限 / p99 相比基线劣化倍数
INDEX_MAX_SEALED_SEGMENTS=64
INDEX_P99_DEGRADE_RATIO=1.5

# ====================
# 监控与慢查询日志
# ====================
# 指标埋点总开关：false 时埋点退化成空操作（怀疑埋点本身影响性能时的对照排查）
METRICS_ENABLED=true
# 是否往 Mongo 写 query_log：false 不影响查询主链路，但线上抽样评测会失去数据源
QUERY_LOG_ENABLED=true
# 慢查询判定阈值：整条链路 / 单路检索，单位毫秒
SLOW_QUERY_TOTAL_MS=3000
SLOW_QUERY_PATH_MS=1000
# 非慢查询的落库抽样比例（1.0=全写；慢查询永远写）。调低可减小 Mongo 压力
QUERY_LOG_SAMPLE_RATE=1.0
# 线上 p99 基线（毫秒）：0=不判定；有值时 p99 超过 基线×INDEX_P99_DEGRADE_RATIO 视为索引劣化
LATENCY_P99_BASELINE_MS=0

# ====================
# 索引巡检调度器（自动发现问题 + 一键触发重建）
# ====================
# 巡检间隔（小时）。容器里跑 python -m processor.index_manager.scheduler --loop
SCHEDULER_INTERVAL_HOURS=6
# 判定出「该重建」后是否真的动手。false=只出结论和可复制的命令，人来决定
SCHEDULER_AUTO_REBUILD=false
# 自动触发时只做到 prepare_only（建好验好停在 ready）：切别名是流量切换，始终留给人确认
SCHEDULER_PREPARE_ONLY=true
# 自动重建的门禁评测每场景取样条数 / 每轮线上抽样评测条数
SCHEDULER_EVAL_LIMIT=20
SCHEDULER_ONLINE_SAMPLE=30

# ====================
# Document Database (MongoDB)
# ====================
# MongoDB 连接 URL
MONGO_URL=mongodb://localhost:27017
# 数据库名
MONGO_DB_NAME=kb001

# ====================
# Object Storage (MinIO)
# ====================
# MinIO 服务端点
MINIO_ENDPOINT=localhost:9000
# 访问密钥
MINIO_ACCESS_KEY=minioadmin
# 私有密钥
MINIO_SECRET_KEY=minioadmin
# 存储桶名称
MINIO_BUCKET_NAME=knowledge-base

# ====================
# Other / MCP Services
# ====================
# MCP Web 搜索服务地址
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse

# ====================
# 监控栈（deploy/monitoring，由 compose 做 ${} 插值）
# ====================
# 下面几项 compose 里都有同样的默认值，不写也能跑，要改才需要写进来
# 告警推送地址。钉钉/飞书机器人的签名与 body 格式和 Alertmanager 不同，需要一个转发网关。
# 默认值故意指向一个没人监听的端口：推不出去会在 Alertmanager 日志里报错，而不是静默丢告警
ALERT_WEBHOOK_URL=http://host.docker.internal:5001/alerts
# Grafana 首次登录账号（进 :3000 后请立刻改密码）
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# 免登录只读看板（演示/内网用），生产环境设为 false
GRAFANA_ANONYMOUS=true